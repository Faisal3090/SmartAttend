// use prisma-next

enum UserRole {
  ADMIN
  FACULTY
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum AttendanceSource {
  BLE
  MANUAL
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

enum AttendanceSessionStatus {
  ACTIVE
  CLOSED
  EXPIRED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  authVersion  Int      @default(1)

  student      Student?
  faculty      Faculty?
  notifications Notification[]
  revokedDevices StudentDevice[] @relation("DeviceRevokedBy")
  refreshSessions RefreshSession[]

  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique

  students    Student[]
  faculty     Faculty[]
  subjects    Subject[]
  classes     Class[]

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Student {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  registerNumber String   @unique
  departmentId   Int
  semester       Int
  section        String
  academicYear   String

  user           User       @relation(fields: [userId], references: [id])
  department     Department @relation(fields: [departmentId], references: [id])
  enrollments    Enrollment[]
  attendance     Attendance[]
  devices        StudentDevice[]
  attendanceChallenges AttendanceChallenge[]
  registrationChallenges RegistrationChallenge[]

  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}

model StudentDevice {
  id                 Int          @id @default(autoincrement())
  studentId          Int
  publicKey          String       @unique
  keyId              String       @unique @default(uuid())
  algorithm          String       @default("EC")
  curve              String       @default("P-256")
  signatureAlgorithm String       @default("SHA256withECDSA")
  status             DeviceStatus @default(ACTIVE)
  isActive           Boolean      @default(true)
  registeredAt       TimestamptzString @default(now())
  lastSeenAt         TimestamptzString?
  revokedAt          TimestamptzString?
  revokedBy          Int?

  student    Student  @relation(fields: [studentId], references: [id])
  revokedByUser User? @relation("DeviceRevokedBy", fields: [revokedBy], references: [id])
  attendanceChallenges AttendanceChallenge[]
  refreshSessions RefreshSession[]

  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()

  @@index([studentId], where: "(\"status\" = 'ACTIVE')", unique: true, name: "studentDevice_one_active_per_student")
}

model Faculty {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  employeeId   String   @unique
  departmentId Int

  user         User       @relation(fields: [userId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])
  classes      Class[]

  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model Subject {
  id           Int      @id @default(autoincrement())
  name         String
  code         String   @unique
  departmentId Int
  credits      Int

  department   Department @relation(fields: [departmentId], references: [id])
  classes      Class[]

  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model Class {
  id           Int      @id @default(autoincrement())
  subjectId    Int
  facultyId    Int
  departmentId Int
  semester     Int
  section      String
  academicYear String

  subject      Subject    @relation(fields: [subjectId], references: [id])
  faculty      Faculty    @relation(fields: [facultyId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])
  enrollments  Enrollment[]
  timetable    Timetable[]
  sessions     AttendanceSession[]

  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model Enrollment {
  id        Int      @id @default(autoincrement())
  studentId Int
  classId   Int

  student   Student @relation(fields: [studentId], references: [id])
  class     Class   @relation(fields: [classId], references: [id])

  createdAt TimestamptzString @default(now())
}

model Timetable {
  id          Int      @id @default(autoincrement())
  classId     Int
  dayOfWeek   Int
  startTime   String
  endTime     String
  room        String?

  class       Class @relation(fields: [classId], references: [id])

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model AttendanceSession {
  id                  Int                     @id @default(autoincrement())
  classId             Int
  sessionDate         TimestamptzString
  startedAt           TimestamptzString       @default(now())
  endedAt             TimestamptzString?
  broadcastTokenHash  String?                 @unique
  expiresAt           TimestamptzString?
  status              AttendanceSessionStatus @default(ACTIVE)

  class       Class        @relation(fields: [classId], references: [id])
  attendance  Attendance[]
  challenges  AttendanceChallenge[]

  @@index([status])
  @@index([expiresAt])

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Attendance {
  id         Int              @id @default(autoincrement())
  sessionId  Int
  studentId  Int
  status     AttendanceStatus
  markedAt   TimestamptzString @default(now())
  source     AttendanceSource
  modifiedBy Int?

  session    AttendanceSession @relation(fields: [sessionId], references: [id])
  student    Student            @relation(fields: [studentId], references: [id])
  logs       AttendanceLog[]

  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model AttendanceChallenge {
  id            String              @id @default(uuid())
  sessionId     Int
  studentId     Int
  deviceId      Int
  challengeHash String              @unique
  expiresAt     TimestamptzString
  consumedAt    TimestamptzString?
  createdAt     TimestamptzString   @default(now())

  session       AttendanceSession   @relation(fields: [sessionId], references: [id])
  student       Student             @relation(fields: [studentId], references: [id])
  device        StudentDevice      @relation(fields: [deviceId], references: [id])

  @@index([sessionId])
  @@index([studentId])
  @@index([deviceId])
  @@index([expiresAt])
}

model RegistrationChallenge {
  id            String             @id @default(uuid())
  studentId     Int
  publicKeyHash String
  challengeHash String             @unique
  expiresAt     TimestamptzString
  consumedAt    TimestamptzString?
  createdAt     TimestamptzString  @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([publicKeyHash])
  @@index([expiresAt])
}

model RefreshSession {
  id         Int               @id @default(autoincrement())
  userId     Int
  deviceId   Int?
  tokenHash  String            @unique
  expiresAt  TimestamptzString
  revokedAt  TimestamptzString?
  createdAt  TimestamptzString  @default(now())
  lastUsedAt TimestamptzString?

  user       User              @relation(fields: [userId], references: [id])
  device     StudentDevice?    @relation(fields: [deviceId], references: [id])

  @@index([userId])
  @@index([deviceId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AttendanceLog {
  id           Int              @id @default(autoincrement())
  attendanceId Int
  oldStatus    AttendanceStatus
  newStatus    AttendanceStatus
  changedBy    Int
  reason       String?
  changedAt    TimestamptzString @default(now())

  attendance   Attendance @relation(fields: [attendanceId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  isRead    Boolean  @default(false)

  user      User     @relation(fields: [userId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
